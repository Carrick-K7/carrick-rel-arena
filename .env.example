# mock | openai | deepseek
AI_PROVIDER=mock

# Text generation. Keep secrets on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# disabled | mock | ark
# Image and video requests stay server-side and require MEDIA_ACCESS_KEY.
MEDIA_PROVIDER=disabled
MEDIA_ACCESS_KEY=
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Public base URL used by Ark to fetch repository-owned portrait references.
MEDIA_PUBLIC_BASE_URL=https://games.carrick7.com/rel-arena/
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_IMAGE_SIZE=2K
ARK_IMAGE_TIMEOUT_MS=180000
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
ARK_VIDEO_RESOLUTION=480p
ARK_VIDEO_RATIO=16:9
ARK_VIDEO_DURATION_SECONDS=15
ARK_VIDEO_POLL_INTERVAL_MS=4000
ARK_VIDEO_TIMEOUT_MS=360000

# auto prefers MiMo, then OpenAI, then browser speech.
TTS_PROVIDER=auto
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=冰糖
MIMO_TTS_FEMALE_VOICE=冰糖
MIMO_TTS_MALE_VOICE=白桦

# Optional secondary server TTS.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_TTS_FEMALE_VOICE=marin
OPENAI_TTS_MALE_VOICE=cedar

PORT=3100
HOST=127.0.0.1
APP_BASE_PATH=/rel-arena
SESSION_TTL_MINUTES=120

# Usage telemetry stores counters only; dialogue text is never written here.
USAGE_LOG_PATH=var/usage-events.jsonl
USAGE_ALERT_LOG_PATH=var/usage-alerts.jsonl
USAGE_ADMIN_TOKEN=
USAGE_ALERT_WEBHOOK_URL=
USAGE_ALERT_SESSION_USD=0.25
USAGE_ALERT_DAILY_USD=5
USAGE_ALERT_SESSION_TOKENS=120000
USAGE_ALERT_ERROR_RATE=0.2
USAGE_ALERT_ERROR_MIN_CALLS=10
USAGE_TIME_ZONE=Asia/Shanghai

# Set all three rates when using an unlisted model.
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_CACHED_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=
# DEEPSEEK_INPUT_USD_PER_MILLION=
# DEEPSEEK_CACHED_INPUT_USD_PER_MILLION=
# DEEPSEEK_OUTPUT_USD_PER_MILLION=
