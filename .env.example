# mock | openai | deepseek
AI_PROVIDER=mock

# Text generation. Keep secrets on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# auto prefers MiMo, then OpenAI, then browser speech.
TTS_PROVIDER=auto
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=冰糖

# Optional secondary server TTS.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

PORT=3100
HOST=127.0.0.1
APP_BASE_PATH=/rel-arena
SESSION_TTL_MINUTES=120

# Usage telemetry stores counters only; dialogue text is never written here.
USAGE_LOG_PATH=var/usage-events.jsonl
USAGE_ALERT_LOG_PATH=var/usage-alerts.jsonl
USAGE_ADMIN_TOKEN=
USAGE_ALERT_WEBHOOK_URL=
USAGE_ALERT_SESSION_USD=0.25
USAGE_ALERT_DAILY_USD=5
USAGE_ALERT_SESSION_TOKENS=120000
USAGE_ALERT_ERROR_RATE=0.2
USAGE_ALERT_ERROR_MIN_CALLS=10
USAGE_TIME_ZONE=Asia/Shanghai

# Set all three rates when using an unlisted model.
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_CACHED_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=
# DEEPSEEK_INPUT_USD_PER_MILLION=
# DEEPSEEK_CACHED_INPUT_USD_PER_MILLION=
# DEEPSEEK_OUTPUT_USD_PER_MILLION=
