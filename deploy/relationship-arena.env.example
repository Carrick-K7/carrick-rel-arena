AI_PROVIDER=mock
APP_BASE_PATH=/rel-arena
SESSION_TTL_MINUTES=120

# Add one server-side key and change AI_PROVIDER for live model calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

MEDIA_PROVIDER=disabled
MEDIA_ACCESS_KEY=
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MEDIA_PUBLIC_BASE_URL=https://games.carrick7.com/rel-arena/
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_REALTIME_IMAGE_SIZE=1K
ARK_IMAGE_TIMEOUT_MS=180000
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
ARK_VIDEO_RESOLUTION=480p
ARK_VIDEO_RATIO=16:9
ARK_VIDEO_DURATION_SECONDS=15
ARK_VIDEO_POLL_INTERVAL_MS=4000
ARK_VIDEO_TIMEOUT_MS=600000

TTS_PROVIDER=auto
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=冰糖
MIMO_TTS_FEMALE_VOICE=冰糖
MIMO_TTS_MALE_VOICE=白桦

OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_TTS_FEMALE_VOICE=marin
OPENAI_TTS_MALE_VOICE=cedar

USAGE_LOG_PATH=/home/ubuntu/projects/relationship-arena/var/usage-events.jsonl
USAGE_ALERT_LOG_PATH=/home/ubuntu/projects/relationship-arena/var/usage-alerts.jsonl
USAGE_ADMIN_TOKEN=
USAGE_ALERT_WEBHOOK_URL=
USAGE_ALERT_SESSION_USD=0.25
USAGE_ALERT_DAILY_USD=5
USAGE_ALERT_SESSION_TOKENS=120000
USAGE_ALERT_ERROR_RATE=0.2
USAGE_ALERT_ERROR_MIN_CALLS=10
USAGE_TIME_ZONE=Asia/Shanghai
